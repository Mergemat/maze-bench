{
  "name": "mazebench",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "bench",
    "dashboard"
  ],
  "scripts": {
    "bench": "bun run bench/src/cli.ts",
    "test": "bun test packages bench",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run --filter dashboard build",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
